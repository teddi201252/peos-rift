 bool Mixer::start(std::string& error) {
+#if defined(__peos__)
+    const int64_t fd = peos_audio_open();
+    if (fd < 0) {
+        error = "peos_audio_open: no audio device (or no \"audio\" capability)";
+        return false;
+    }
+    auto* out = new PeosOutput();
+    out->fd = fd;
+    output_rate_ = kPeosRate;
+    device_ = out;
+    out->thread = std::thread([this, out] {
+        std::vector<float> mixed(size_t(kPeosPeriod) * 2);
+        std::vector<int16_t> pcm(mixed.size());
+        while (!out->stop.load(std::memory_order_relaxed)) {
+            bool playing = false;
+            {
+                std::lock_guard<std::mutex> lock(mutex_);
+                for (const SourceVoice* voice : voices_)
+                    if (voice->playing_) {
+                        playing = true;
+                        break;
+                    }
+            }
+            if (!playing) {   // nothing to play: no silence sent, the device rests
+                std::this_thread::sleep_for(std::chrono::milliseconds(5));
+                continue;
+            }
+            mix(mixed.data(), kPeosPeriod);
+            for (size_t i = 0; i < mixed.size(); ++i)
+                pcm[i] = int16_t(std::lrint(std::clamp(mixed[i], -1.f, 1.f) * 32767.f));
+            const size_t bytes = pcm.size() * sizeof(int16_t);
+            if (peos_fwrite(uint64_t(out->fd), pcm.data(), bytes) != bytes) break;   // the device went
+        }
+    });
+    return true;

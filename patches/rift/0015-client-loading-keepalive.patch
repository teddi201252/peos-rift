+void NetClient::startLoadingKeepalive() {
+    if (keepalive_thread_.joinable()) return;
+    keepalive_services_ = 0;
+    last_poll_ns_ = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    keepalive_run_ = true;
+    keepalive_thread_ = std::thread([this] {
+        while (keepalive_run_.load()) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count();
+            if (now - last_poll_ns_.load() < 100000000) continue;   // the loading polls by itself
+            std::lock_guard<std::recursive_mutex> enet_lock(enet_mutex_);
+            if (!host_) continue;
+            enet_host_service(host_, nullptr, 0);   // acknowledgements out, packets queued for poll()
+            ++keepalive_services_;
+        }
+    });
 }
 
+void NetClient::stopLoadingKeepalive() {
+    if (!keepalive_thread_.joinable()) return;
+    keepalive_run_ = false;
+    keepalive_thread_.join();
+    LOG_INFO(logging::Category::Net, "loading keepalive: the network serviced {} times while the loading was busy",
+             keepalive_services_);
 }

+namespace {
+// The newer .ltk ("IMAA"): u32 atlas count, a u64 path hash per atlas, u32
+// sprite count, then per sprite u64 image hash, f32 u0 v0 u1 v1, u32 atlas.
+// An atlas is "uiautoatlas/<the .ltk's path without .ltk>/atlas_<n>.tex",
+// which its hash (xxh64 of the lowercase path, as WAD names) confirms.
+AtlasSpriteMap parse_imaa(std::span<const std::byte> file, std::string_view ltk_path) {
+    std::string stem = normalizeAssetKey(ltk_path);
+    if (const size_t wad = stem.find(".wad/"); wad != std::string::npos)
+        stem.erase(0, wad + 5);   // under the WAD
+    if (stem.size() > 4 && stem.compare(stem.size() - 4, 4, ".ltk") == 0)
+        stem.resize(stem.size() - 4);
+    if (stem.empty())
+        throw ParseError("IMAA: the .ltk's path is needed to name its atlases");
+
+    Reader reader(file);
+    (void)reader.get<u32>();   // "IMAA"
+    const u32 atlas_count = reader.get<u32>();
+    if (atlas_count == 0 || atlas_count > 64)
+        throw ParseError("IMAA: zla liczba atlasow");
+    std::vector<std::string> atlases;
+    for (u32 index = 0; index < atlas_count; ++index) {
+        const u64 hash = reader.get<u64>();
+        std::string found;
+        for (u32 n = 0; n < 64 && found.empty(); ++n) {
+            const std::string candidate = "uiautoatlas/" + stem + "/atlas_" + std::to_string(n) + ".tex";
+            if (XXH64(candidate.data(), candidate.size(), 0) == hash)
+                found = candidate;
+        }
+        if (found.empty())
+            throw ParseError("IMAA: no atlas name for its hash");
+        atlases.push_back(std::move(found));
+    }
+    const u32 sprite_count = reader.get<u32>();
+    if (sprite_count > 100000)
+        throw ParseError("IMAA: zla liczba sprite'ow");
+    AtlasSpriteMap result;
+    result.reserve(sprite_count);
+    for (u32 sprite_index = 0; sprite_index < sprite_count; ++sprite_index) {
+        const u64 image = reader.get<u64>();
+        AtlasSprite sprite;
+        sprite.u0 = reader.get<float>();
+        sprite.v0 = reader.get<float>();
+        sprite.u1 = reader.get<float>();
+        sprite.v1 = reader.get<float>();
+        const u32 atlas = reader.get<u32>();
+        if (atlas >= atlases.size())
+            throw ParseError("IMAA: atlas index out of range");
+        if (!std::isfinite(sprite.u0) || !std::isfinite(sprite.v0) || !std::isfinite(sprite.u1) ||
+            !std::isfinite(sprite.v1) || sprite.u0 < 0.f || sprite.v0 < 0.f || sprite.u1 > 1.f ||
+            sprite.v1 > 1.f || sprite.u1 <= sprite.u0 || sprite.v1 <= sprite.v0)
+            throw ParseError("IMAA: zly prostokat UV");
+        sprite.texture = atlases[atlas];
+        result.emplace(wad_link_key(image), std::move(sprite));
+    }
+    if (reader.remaining() != 0)
+        throw ParseError("IMAA: data past the end of the table");
+    return result;
+}
+}

+bool archive_only(const filesystem::path& path) {
+#if defined(__peos__)
+    if (!active())
+        return false;
+    const std::string key = pathKey(path);
+    std::shared_lock mount_lock(g_mount_mutex);
+    for (const std::string& root_key : g_archive_only_roots)
+        if (key.size() > root_key.size() && key.compare(0, root_key.size(), root_key) == 0 &&
+            key[root_key.size()] == '/')
+            return true;
+#else
+    (void)path;
+#endif
+    return false;
+}

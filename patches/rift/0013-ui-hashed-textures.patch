+std::filesystem::path UiTextures::hashedFile(const std::string& key) {
+    if (!hashed_ready_) {
+        hashed_ready_ = true;
+        size_t files = 0;
+        for (size_t root = 0; root < named_roots_; ++root) {
+            const std::string prefix = roots_[root].generic_string() + "/";
+            for (const fmt::vfs::Item& item : fmt::vfs::list(roots_[root], true)) {
+                if (item.is_directory()) continue;
+                const std::string full = item.path().generic_string();
+                if (full.compare(0, prefix.size(), prefix) != 0) continue;
+                const std::string relative = lowercase(full.substr(prefix.size()));
+                hashed_.emplace(XXH64(relative.data(), relative.size(), 0), item.path());
+                ++files;
+            }
+        }
+        std::fprintf(stderr, "ui textures: %zu files by path hash, from %zu WADs\n", files, named_roots_);
+    }
+    const uint64_t hash = std::strtoull(key.c_str() + 1, nullptr, 16);
+    const auto found = hashed_.find(hash);
+    return found == hashed_.end() ? std::filesystem::path() : found->second;
+}
+
 GLuint UiTextures::get(const std::string& asset_path) {
     if (asset_path.empty()) return 0;
     if (const auto found = cache_.find(asset_path); found != cache_.end()) return found->second;
+    if (asset_path[0] == '#') {
+        // A WAD path hash: the file it names, as its own path (cached under both)
+        const std::filesystem::path file = hashedFile(asset_path);
+        const GLuint texture = file.empty() ? 0 : get(file.generic_string());
+        if (!texture) {
+            static int said = 0;
+            if (said++ < 8)
+                std::fprintf(stderr, "ui textures: %s %s\n", asset_path.c_str(),
+                             file.empty() ? "is no file of the WADs" : ("did not load: " + file.generic_string()).c_str());
+            ++missing_;
+            if (missing_names_.size() < 32) missing_names_.push_back(asset_path);
+        }
+        cache_.emplace(asset_path, texture);
+        if (texture) size_[asset_path] = size(file.generic_string());
+        return texture;
+    }
 
     PROF_COUNT(Textures, 1);
 

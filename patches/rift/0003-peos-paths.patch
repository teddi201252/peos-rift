@@ -115,16 +127,55 @@ ResolvedDirectory resolveDirectory(const char* flag, const wchar_t* variable, co
     return {compiled, "compiled-in"};
 }
 
+#if defined(__peos__)
+// PeOS: the game's files on a disk of the user's (a stick, an external disk),
+// mounted as /media1 ... /media9: the first with league-assets/Global.wad
+fs::path peosMediaAssets() {
+    std::error_code error;
+    for (int n = 1; n <= 9; ++n) {
+        const fs::path candidate = fs::path("/media" + std::to_string(n)) / "league-assets";
+        if (fs::exists(candidate / "Global.wad", error) || fs::exists(candidate / "Global.wad.xpa", error))
+            return candidate;
+    }
+    return {};
+}
+#endif
+
 const ResolvedDirectory& assetDirectory() {
-    static const ResolvedDirectory resolved =
-        resolveDirectory("--assets", kAssetDirectoryVariable, LOLCLONE_ASSET_DIR,
-                         executableDirectoryOrCurrent() / "league-assets", "Global.wad");
+    static const ResolvedDirectory resolved = [] {
+        ResolvedDirectory found =
+            resolveDirectory("--assets", kAssetDirectoryVariable, LOLCLONE_ASSET_DIR,
+                             executableDirectoryOrCurrent() / "league-assets", "Global.wad");
+#if defined(__peos__)
+        if (found.source == "compiled-in")
+            if (fs::path media = peosMediaAssets(); !media.empty()) found = {media, "a disk (/mediaN)"};
+#endif
+        return found;
+    }();
     return resolved;
 }
 
 const ResolvedDirectory& dataDirectory() {
-    static const ResolvedDirectory resolved = resolveDirectory(

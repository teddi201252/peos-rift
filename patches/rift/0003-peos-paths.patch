+    static const ResolvedDirectory resolved = [] {
+        ResolvedDirectory found = resolveDirectory(
+            "--data", kDataDirectoryVariable, LOLCLONE_SOURCE_DIR, executableDirectoryOrCurrent(), "scripts/items");
+#if defined(__peos__)
+        // PeOS: Rift Ascend's own files (scripts, its assets) on the game's
+        // disk beside league-assets, as rift-data (a live system's root holds
+        // at most 1024 files: they do not fit in the app's bundle there)
+        if (found.source == "compiled-in") {
+            std::error_code error;
+            for (int n = 1; n <= 9; ++n) {
+                const fs::path candidate = fs::path("/media" + std::to_string(n)) / "rift-data";
+                if (fs::exists(candidate / "scripts/items", error)) {
+                    found = {candidate, "a disk (/mediaN)"};
+                    break;
+                }
+            }
+        }
+#endif
+        return found;
+    }();
     return resolved;
 }
 

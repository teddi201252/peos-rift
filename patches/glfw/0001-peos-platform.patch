diff --git a/src/null_window.c b/src/null_window.c
index 0a42d436..5c71f383 100644
--- a/src/null_window.c
+++ b/src/null_window.c
@@ -119,8 +119,20 @@ GLFWbool _glfwCreateWindowNull(_GLFWwindow* window,
     if (!createNativeWindow(window, wndconfig, fbconfig))
         return GLFW_FALSE;
 
+#if defined(__peos__)
+    _glfwPeOSWindowCreated(window);
+#endif
+
     if (ctxconfig->client != GLFW_NO_API)
     {
+#if defined(__peos__)
+        if (ctxconfig->source == GLFW_NATIVE_CONTEXT_API)
+        {
+            if (!_glfwCreateContextPeOS(window, ctxconfig, fbconfig))
+                return GLFW_FALSE;
+        }
+        else
+#endif
         if (ctxconfig->source == GLFW_NATIVE_CONTEXT_API ||
             ctxconfig->source == GLFW_OSMESA_CONTEXT_API)
         {
@@ -168,6 +180,9 @@ GLFWbool _glfwCreateWindowNull(_GLFWwindow* window,
 
 void _glfwDestroyWindowNull(_GLFWwindow* window)
 {
+#if defined(__peos__)
+    _glfwPeOSWindowDestroyed(window);
+#endif
     if (window->monitor)
         releaseMonitor(window);
 
@@ -487,14 +502,23 @@ GLFWbool _glfwWindowVisibleNull(_GLFWwindow* window)
 
 void _glfwPollEventsNull(void)
 {
+#if defined(__peos__)
+    _glfwPeOSPump(0.0);
+#endif
 }
 
 void _glfwWaitEventsNull(void)
 {
+#if defined(__peos__)
+    _glfwPeOSPump(-1.0);
+#endif
 }
 
 void _glfwWaitEventsTimeoutNull(double timeout)
 {
+#if defined(__peos__)
+    _glfwPeOSPump(timeout);
+#endif
 }
 
 void _glfwPostEmptyEventNull(void)
@@ -517,12 +541,18 @@ void _glfwSetCursorPosNull(_GLFWwindow* window, double x, double y)
 
 void _glfwSetCursorModeNull(_GLFWwindow* window, int mode)
 {
+#if defined(__peos__)
+    _glfwPeOSSetCursorMode(window, mode);
+#endif
 }
 
 GLFWbool _glfwCreateCursorNull(_GLFWcursor* cursor,
                                const GLFWimage* image,
                                int xhot, int yhot)
 {
+#if defined(__peos__)
+    _glfwPeOSCreateCursor(cursor, image, xhot, yhot);
+#endif
     return GLFW_TRUE;
 }
 
@@ -533,14 +563,23 @@ GLFWbool _glfwCreateStandardCursorNull(_GLFWcursor* cursor, int shape)
 
 void _glfwDestroyCursorNull(_GLFWcursor* cursor)
 {
+#if defined(__peos__)
+    _glfwPeOSDestroyCursor(cursor);
+#endif
 }
 
 void _glfwSetCursorNull(_GLFWwindow* window, _GLFWcursor* cursor)
 {
+#if defined(__peos__)
+    _glfwPeOSSetCursor(window, cursor);
+#endif
 }
 
 void _glfwSetClipboardStringNull(const char* string)
 {
+#if defined(__peos__)
+    _glfwPeOSSetClipboardString(string);
+#endif
     char* copy = _glfw_strdup(string);
     _glfw_free(_glfw.null.clipboardString);
     _glfw.null.clipboardString = copy;
@@ -548,6 +587,9 @@ void _glfwSetClipboardStringNull(const char* string)
 
 const char* _glfwGetClipboardStringNull(void)
 {
+#if defined(__peos__)
+    _glfwPeOSGetClipboardString();
+#endif
     return _glfw.null.clipboardString;
 }
 
diff --git a/src/platform.c b/src/platform.c
index 9055c33d..e6de7ffc 100644
--- a/src/platform.c
+++ b/src/platform.c
@@ -74,6 +74,12 @@ GLFWbool _glfwSelectPlatform(int desiredID, _GLFWplatform* platform)
         return GLFW_FALSE;
     }
 
+#if defined(__peos__)
+    // PeOS: the Null platform is the one (its window in Starlight)
+    if (desiredID == GLFW_ANY_PLATFORM)
+        desiredID = GLFW_PLATFORM_NULL;
+#endif
+
     // Only allow the Null platform if specifically requested
     if (desiredID == GLFW_PLATFORM_NULL)
         return _glfwConnectNull(desiredID, platform);
